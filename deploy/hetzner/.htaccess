# Plaats dit bestand in de document root van handbalsint-truiden.be (naast
# app.fcgi). Stuurt alle requests die geen bestaand bestand zijn (dus geen
# /static/...) door naar de FastCGI-app.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ app.fcgi/$1 [QSA,L]
</IfModule>
