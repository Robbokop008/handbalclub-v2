# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# Het .env-bestand zelf hoort NOOIT in git terecht te komen.

SECRET_KEY=verander-dit-in-een-lange-willekeurige-string
# DATABASE_URL laten we standaard leeg: config.py gebruikt dan automatisch
# een absoluut pad naar instance/handbalclub.db. Zet deze alleen als je een
# andere database (bv. PostgreSQL in productie) wilt gebruiken.
# DATABASE_URL=postgresql://user:wachtwoord@host/dbnaam

# Stripe (webshop betalingen) - haal deze op uit je Stripe dashboard
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# ID van de 'Verzendingskosten' shipping rate in Stripe (test- en live-mode
# hebben elk hun eigen ID - dit moet je aanpassen bij overschakelen naar live)
STRIPE_SHIPPING_RATE_ID=shr_...

# Embed-URL van de Spond-wedstrijdenkalender (via Spond zelf op te vragen)
SPOND_EMBED_URL=https://spond.com/

# Mail via de mailserver van Hetzner. De site logt in met de mailbox
# webmaster@ (MAIL_USERNAME/MAIL_PASSWORD, zie konsoleH > E-Mail >
# Mailboxen), maar verstuurt als club@ (MAIL_FROM, een forward). MAIL_ADMIN
# krijgt de meldingen: contactformulier, inschrijvingen, GDPR-verzoeken en
# annuleringen. Zonder wachtwoord werkt de site gewoon, enkel mails worden
# dan niet verstuurd (de fout komt in de log).
MAIL_SERVER=www767.your-server.de
MAIL_PORT=587
MAIL_USERNAME=webmaster@handbalsint-truiden.be
MAIL_PASSWORD=...
MAIL_FROM=club@handbalsint-truiden.be
MAIL_ADMIN=club@handbalsint-truiden.be

# Google Analytics Measurement ID (Beheerder > Gegevensstromen in GA) - leeg
# laten schakelt het Analytics-script en de cookiebanner volledig uit.
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vaste canonieke basis-URL voor de <link rel="canonical">-tag (zie
# templates/base.html). Enkel nodig als het domein ooit verandert - config.py
# gebruikt anders al https://handbalsint-truiden.be als standaardwaarde.
# CANONICAL_BASE_URL=https://handbalsint-truiden.be
